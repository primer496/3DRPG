#TempFeedback-Foldout {
    background-color: rgba(16, 16, 16, 0);
    font-size: 13px;
    padding: 3px 1px;
}

#TempFeedback-Button {
    background-image: resource("Icons/Feedback_QRCode");
    width: 120px;
    height: 120px;
    margin: 4px 0 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

#TempFeedback-Label {
    margin: 2px 0 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: italic;
}

#TempFeedback-TestLabel {
    align-self: center;
    align-items: center;
    align-content: center;
    margin: 2px 0 0;
    padding: 0;
    font-size: 12px;
}

FeedbackView {
    position: absolute;
    left: 1px;
    bottom: 1px;
    margin: 1px;
    padding: 0;
}