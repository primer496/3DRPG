        <ui:TextField picking-mode="Ignore" label="obj url" name="objUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="mtl url" name="mtlUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="texture image url" name="textureImageUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="pbr metallic url" name="pbrMetallicUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="pbr roughness url" name="pbrRougnessUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="pbr normal map url" name="pbrNormalUrlField" keyboard-type="URL" />
        <ui:TextField picking-mode="Ignore" label="pbr base map url" name="pbrBaseMapUrlField" keyboard-type="URL" />
    </ui:VisualElement>
</ui:UXML>
