.stack-node > #stackNodeHeaderContainer {
    flex-direction: row;
    justify-content: flex-start;
    align-items: stretch;
    margin-bottom: 15px;
}

.stack-node > #stackNodeHeaderContainer > #collapse-button {
    -unity-background-scale-mode: scale-to-fit;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    align-self: center;
    opacity: 0.5;
    visibility: hidden;
}

#collapse-button:hover:enabled {
    background-color: rgba(0.169,0.169,0.169,1.0);
    border-radius: 1px;
    opacity: 1;
}

.stack-node:hover > #stackNodeHeaderContainer > #collapse-button {
    visibility: visible;
}

.stack-node.collapsed > #stackNodeHeaderContainer > #collapse-button {
    background-image: resource("graphview/nodes/nodechevronleft.png");
}

.stack-node.expanded > #stackNodeHeaderContainer > #collapse-button {
    background-image: resource("graphview/nodes/nodechevrondown.png");
}