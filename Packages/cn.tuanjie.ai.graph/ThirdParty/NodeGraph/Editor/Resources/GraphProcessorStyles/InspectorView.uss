.NodeControls
{
    border-width: 1.2px;
    border-radius: 8px;
    border-color: #161616;
    padding: 8px;
    margin-right:8px;
    margin-top: 8px;
}

.NodeControls > Label
{
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.PlaceHolder
{
    font-size: 14px;
    padding: 8px;
    margin-right:8px;
    margin-bottom: 8px;
}

#description
{
    font-size: 12px;
    white-space: normal; 
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

#refreshContainer {
    flex-direction: row;
    justify-content: space-between;
}

#refreshContainer > DropdownField > .unity-popup-field__input {
    min-width: 120px;
}

#refreshContainer > Button {
    min-height: 20px;
    min-width: 20px;
    background-image: resource("Icons/Refresh");
}

.NodeControls > TextField > #unity-text-input {
    white-space: normal;
}

.NodeControls > .unity-foldout {
    margin-left: 12px;
}

#MuseBeautifyView TextElement {
    max-width: 100%;
}

#PromptListView .unity-foldout {
    margin-left: 12px;
}