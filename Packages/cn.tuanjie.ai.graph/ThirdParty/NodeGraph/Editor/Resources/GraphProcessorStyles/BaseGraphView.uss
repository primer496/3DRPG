#graphRootView
{
    background-color: #101010;
}
#TokenLabel {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: white;
}
#LegalTitle {
    position: absolute;
    top: 10px;
    align-self: center;
    align-content: center;
    color: rgba(73, 73, 73, 0.75);
    -unity-font-definition: resource('Fonts/NotoSansSC-Regular SDF 20');
}
.sticky-note{
    -unity-font-definition: resource('Fonts/NotoSansSC-Regular SDF 20');
}
