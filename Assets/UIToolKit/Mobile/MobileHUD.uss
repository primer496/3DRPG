/* ===== 全局字体（中文支持） ===== */
* {
    -unity-font: resource("Fonts/NotoSansSC-Regular");
}

/* ===== 根容器 ===== */
.mobile-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
}

/* ===== 交互元素通用恢复 pointer-events ===== */
.mobile-btn,
.mobile-joystick-area {
    pointer-events: auto;
}

/* ===== 摇杆区域 ===== */
.mobile-joystick-area {
    position: absolute;
    left: 40px;
    bottom: 60px;
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
}

/* 底座背景图（Sprite 由 C# 代码赋值） */
.joystick-base {
    position: absolute;
    width: 180px;
    height: 180px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 手柄小球：居中布局，通过代码 translate 偏移 */
.joystick-handle {
    position: absolute;
    width: 80px;
    height: 80px;
    left: 50px;
    top: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ===== 右下攻击+闪避容器 ===== */
.mobile-action-btns {
    position: absolute;
    right: 30px;
    bottom: 50px;
    flex-direction: row;
    align-items: flex-end;
}

/* 右侧 跳跃+攻击 纵向堆叠 */
.mobile-attack-stack {
    flex-direction: column;
    align-items: center;
    margin-left: 12px;
}

/* ===== 跳跃按钮（中圆，攻击上方） ===== */
.mobile-jump-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: rgba(40, 180, 80, 0.5);
    border-width: 3px;
    border-color: rgba(80, 220, 120, 0.8);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

/* ===== 攻击按钮（大圆） ===== */
.mobile-attack-btn {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: rgba(200, 40, 40, 0.5);
    border-width: 3px;
    border-color: rgba(255, 80, 80, 0.8);
    align-items: center;
    justify-content: center;
}

/* ===== 闪避按钮（小圆） ===== */
.mobile-dodge-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: rgba(40, 100, 220, 0.5);
    border-width: 3px;
    border-color: rgba(80, 140, 255, 0.8);
    align-items: center;
    justify-content: center;
}

/* ===== 右上菜单按钮容器 ===== */
.mobile-menu-btns {
    position: absolute;
    right: 20px;
    top: 20px;
    flex-direction: column;
}

/* ===== 背包/任务小方块按钮 ===== */
.mobile-menu-btn {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.7);
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

/* ===== 对话入口按钮（中下方，胶囊形） ===== */
.mobile-interact-btn {
    position: absolute;
    bottom: 30%;
    left: 50%;
    translate: -50% 0;
    height: 48px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 24px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.8);
    align-items: center;
    justify-content: center;
}

/* ===== 按钮文字 ===== */
.mobile-btn-label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mobile-attack-btn > .mobile-btn-label {
    font-size: 22px;
}

.mobile-interact-btn > .mobile-btn-label {
    font-size: 18px;
    color: rgb(255, 215, 0);
}
