.mobile-hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.mobile-btn {
}

.mobile-joystick-area {
}

.mobile-joystick-area {
    position: absolute;
    left: 40px;
    bottom: 60px;
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
}

.joystick-base {
    position: absolute;
    width: 180px;
    height: 180px;
    -unity-background-scale-mode: scale-to-fit;
}

.joystick-handle {
    position: absolute;
    width: 80px;
    height: 80px;
    left: 50px;
    top: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

.mobile-action-btns {
    position: absolute;
    right: 30px;
    bottom: 50px;
    flex-direction: row;
    align-items: flex-end;
}

.mobile-attack-stack {
    flex-direction: column;
    align-items: center;
    margin-left: 12px;
}

.mobile-jump-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: rgba(40, 180, 80, 0.5);
    border-width: 3px;
    border-color: rgba(80, 220, 120, 0.8);
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    -unity-font: resource('Fonts/NotoSansSC-Regular');
}

.mobile-attack-btn {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: rgba(200, 40, 40, 0.5);
    border-width: 3px;
    border-color: rgba(255, 80, 80, 0.8);
    align-items: center;
    justify-content: center;
}

.mobile-dodge-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: rgba(40, 100, 220, 0.5);
    border-width: 3px;
    border-color: rgba(80, 140, 255, 0.8);
    align-items: center;
    justify-content: center;
}

.mobile-menu-btns {
    position: absolute;
    right: 20px;
    top: 20px;
    flex-direction: column;
}

.mobile-menu-btn {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.7);
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

.mobile-interact-btn {
    position: absolute;
    bottom: 30%;
    left: 50%;
    translate: -50% 0;
    height: 48px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 24px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.8);
    align-items: center;
    justify-content: center;
}

.mobile-btn-label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mobile-attack-btn > .mobile-btn-label {
    font-size: 22px;
}

.mobile-interact-btn > .mobile-btn-label {
    font-size: 18px;
    color: rgb(255, 215, 0);
}
