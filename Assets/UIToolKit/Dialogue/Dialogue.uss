.dialogue-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    position: relative;
}

.background-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    -unity-background-scale-mode: stretch-to-fill;
}

.main-content {
    position: relative;
    width: 100%;
    height: 100%;
    flex-direction: row;
}

.options-container {
    position: absolute;
    right: 32px;
    bottom: 340px;
    flex-direction: column;
    gap: 14px;
    width: 340px;
}

.option-btn {
    height: 60px;
    background-color: rgba(25, 25, 25, 0.95);
    border-width: 1px;
    border-color: rgba(80, 100, 120, 0.25);
    border-radius: 8px;
    color: rgb(210, 210, 210);
    font-size: 18px;
    padding: 0 24px;
    justify-content: flex-start;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
}

.option-btn:hover {
    background-color: rgba(35, 45, 55, 0.98);
    border-color: rgba(100, 150, 180, 0.5);
    border-left-width: 4px;
    border-left-color: rgb(80, 140, 180);
}

.option-btn:active {
    background-color: rgba(45, 65, 85, 0.98);
    border-color: rgba(120, 170, 200, 0.6);
    border-left-width: 5px;
    border-left-color: rgb(100, 160, 200);
    color: rgb(255, 255, 255);
}

.dialogue-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(18, 18, 18, 0.98);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 0;
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.7);
    max-height: 340px;
}

.dialogue-top-bar {
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, rgb(60, 120, 150), rgb(80, 150, 180), rgb(60, 120, 150));
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

.dialogue-content {
    padding: 28px;
    padding-top: 24px;
    padding-bottom: 20px;
}

.character-info {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.character-name {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.character-name-decorator {
    width: 5px;
    height: 24px;
    background: linear-gradient(180deg, rgb(80, 150, 180), rgb(60, 120, 150));
    margin-right: 14px;
    border-radius: 3px;
}

.dialogue-text-container {
    flex-grow: 1;
    min-height: 160px;
    margin-bottom: 20px;
}

.dialogue-text {
    font-size: 19px;
    line-height: 1.7;
    color: rgb(200, 200, 200);
    white-space: normal;
    word-wrap: break-word;
}

.bottom-bar {
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-right: 20px;
}

.continue-indicator {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
}

.continue-icon {
    width: 24px;
    height: 24px;
    background-image: url("continue.png");
    -unity-background-scale-mode: scale-to-fit;
}
