.hud-root {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 280px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    flex-direction: column;
}

.hud-section {
    margin-bottom: 6px;
}

.hud-label {
    font-size: 12px;
    color: rgb(200, 200, 200);
    margin-bottom: 2px;
}

.hud-progress {
    height: 16px;
    flex-grow: 1;
}

.hp-bar .unity-progress-bar__progress {
    background-color: rgb(220, 60, 60);
}

.hp-bar .unity-progress-bar__background {
    background-color: rgba(255, 255, 255, 0.1);
}

.exp-bar .unity-progress-bar__progress {
    background-color: rgb(80, 180, 80);
}

.exp-bar .unity-progress-bar__background {
    background-color: rgba(255, 255, 255, 0.1);
}

.hud-level {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 220, 100);
    margin-top: 2px;
}

.hud-gold {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 200, 50);
}
